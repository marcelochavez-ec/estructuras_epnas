        <mxCell id="L_e1" value="renderiza" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#667085;fontColor=#475467;fontSize=9;startArrow=none;endArrow=block;endFill=1;" edge="1" parent="1" source="L_meta" target="L_input">
