        <mxCell id="L_note" value="&lt;b&gt;patrón para epnas:&lt;/b&gt; la definición del formulario es global y reutilizable; cada sección solo aporta sus campos y su tabla de respuestas. no se crea una tabla de catálogo nueva por cada ítem." style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#D0D5DD;strokeWidth=1;fontColor=#475467;fontSize=9;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
