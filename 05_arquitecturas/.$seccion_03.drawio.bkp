        <mxCell id="L_input" value="&lt;b&gt;&lt;font color=&quot;#243C8F&quot; size=&quot;4&quot;&gt;1. entrada de datos s03&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;
&lt;table border=&quot;0&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; width=&quot;100%&quot;&gt;
&lt;tr&gt;&lt;td&gt;&lt;b&gt;campo&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;control web&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;formato que ingresa&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;regla&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;s03_am01&lt;/td&gt;&lt;td&gt;select&lt;/td&gt;&lt;td&gt;id_opcion&lt;/td&gt;&lt;td&gt;3 opciones&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;s03_am02&lt;/td&gt;&lt;td&gt;select&lt;/td&gt;&lt;td&gt;id_opcion&lt;/td&gt;&lt;td&gt;4 opciones&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;s03_am03&lt;/td&gt;&lt;td&gt;select&lt;/td&gt;&lt;td&gt;id_opcion&lt;/td&gt;&lt;td&gt;3 opciones&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;s03_am04&lt;/td&gt;&lt;td&gt;select&lt;/td&gt;&lt;td&gt;id_opcion&lt;/td&gt;&lt;td&gt;2 opciones&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;s03_am05&lt;/td&gt;&lt;td&gt;number&lt;/td&gt;&lt;td&gt;decimal en horas&lt;/td&gt;&lt;td&gt;valor &amp;gt;= 0&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;s03_am06&lt;/td&gt;&lt;td&gt;select&lt;/td&gt;&lt;td&gt;id_opcion&lt;/td&gt;&lt;td&gt;3 opciones&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;
&lt;br&gt;&lt;b&gt;criterio:&lt;/b&gt; los campos select no reciben texto libre; reciben el identificador de una opción activa del catálogo." style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#4D6CB3;strokeWidth=1.2;fontColor=#172033;fontSize=9;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
